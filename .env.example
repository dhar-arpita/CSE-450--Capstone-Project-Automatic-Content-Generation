# Root .env — read automatically by `docker compose` for variable
# substitution inside docker-compose.yml (separate from backend/.env, which
# is injected INTO the backend container's own environment).
#
# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets.
#
# Correction (Step 1.6): SECRET_KEY and CORS_ORIGINS ended up in
# backend/.env.example instead — they're read by Python via os.getenv()
# inside the backend container (env_file:), not substituted into this YAML
# file by `docker compose` itself, so they belong in backend/.env, not here.
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND aren't set as plain values
# anywhere — docker-compose.yml computes them from REDIS_PASSWORD below.
# This file still only needs what Step 1.2 introduced.

# Redis (message broker). Required — docker-compose.yml refuses to start the
# redis service if this is unset, rather than silently starting it unprotected.
# Generate one with: openssl rand -hex 24
REDIS_PASSWORD=changeme-generate-a-real-one
REACT_APP_API_URL=http://localhost:8000
