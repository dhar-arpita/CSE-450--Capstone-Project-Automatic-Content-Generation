# ── Gemini: Vertex AI vs AI Studio ────────────────────────────────────────────
# "true"  = route Gemini calls through Vertex AI (bills your GCP project /
#           free-trial credit, auth via service account).
# "false" = use the AI Studio API key below (original behavior).
GOOGLE_GENAI_USE_VERTEXAI=false

# AI Studio API key — only used when GOOGLE_GENAI_USE_VERTEXAI=false.
GOOGLE_API_KEY=your-ai-studio-api-key

# Vertex express mode API key (bound to a service account in your GCP project,
# e.g. vertex-express@<project>.iam.gserviceaccount.com). If set, this is the
# only Vertex credential needed — project and location are inferred from it.
GOOGLE_VERTEX_API_KEY=your-vertex-express-api-key

# --- Alternative to GOOGLE_VERTEX_API_KEY: service-account (ADC) mode ---
# GCP project ID that Vertex usage is billed to.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex region. us-central1 works for gemini-2.5-flash and
# gemini-embedding-001; Gemini 3.x models may require "global".
GOOGLE_CLOUD_LOCATION=us-central1

# Absolute path to a service-account JSON key with the "Vertex AI User" role
# (read automatically by the SDK as ADC).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── Qdrant vector DB ──────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── PostgreSQL (Supabase) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
