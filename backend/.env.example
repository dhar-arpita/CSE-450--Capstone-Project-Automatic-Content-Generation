# backend/.env.example — Step 1.6 (DEPLOYMENT_PLAN.md)
#
# Copy this file to backend/.env and fill in real values. backend/.env is
# gitignored (bare ".env" in the root .gitignore matches at every depth) —
# never commit real secrets. This is injected into the backend container via
# docker-compose.yml's `env_file: - ./backend/.env`.
#
# Separate from the ROOT .env.example, which only holds REDIS_PASSWORD —
# that one is read directly by `docker compose` itself for YAML
# substitution, a different mechanism from this file.

# ── Required — backend refuses to start without these ──────────────────────

# PostgreSQL connection string (core/config.py raises at import if unset).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT signing key for login tokens (core/config.py raises at import if
# unset — Step 1.6, R9). HS256 signs AND verifies with this same value, so a
# missing/guessable key is a full auth bypass, not just a broken feature.
# Generate one with: openssl rand -hex 32
SECRET_KEY=changeme-generate-a-real-one

# Mistral OCR client is constructed eagerly at import (utils/parser.py) —
# missing this crashes on first import, not just on first use.
MISTRAL_API_KEY=your-mistral-api-key

# ── Gemini — pick ONE mode ───────────────────────────────────────────────────
# GOOGLE_GENAI_USE_VERTEXAI=false (default): AI Studio via GOOGLE_API_KEY.
# GOOGLE_GENAI_USE_VERTEXAI=true: Vertex AI, via EITHER GOOGLE_VERTEX_API_KEY
#   (express mode) OR GOOGLE_CLOUD_PROJECT + GOOGLE_APPLICATION_CREDENTIALS
#   (service-account mode). core/config.py raises at import if this mode is
#   selected but neither credential path is fully set.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=your-ai-studio-api-key
GOOGLE_VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ── Optional — code falls back gracefully if unset ──────────────────────────

# Qdrant Cloud. If QDRANT_URL is unset, core/config.py falls back to an
# in-memory Qdrant instance (fine for a quick local smoke test, but vectors
# vanish on every restart and aren't shared with other containers).
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Comma-separated CORS allow-list (Step 1.5, R9). Falls back to
# http://localhost:3000 (the dev frontend's own compose port) if unset.
CORS_ORIGINS=http://localhost:3000

# YouTube Data API — video_search_agent.py checks `if not YOUTUBE_API_KEY`
# before calling out, so this is safe to leave empty (that feature is just
# disabled, nothing crashes).
YOUTUBE_API_KEY=

# ── NOT set here ─────────────────────────────────────────────────────────────
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND (Step 1.4) are computed
# automatically by docker-compose.yml from the ROOT .env's REDIS_PASSWORD —
# there is nothing to set manually for them here.
